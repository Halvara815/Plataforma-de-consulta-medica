# Environment files and local configuration
.env
.env.*
!.env.example
!.env.*.example
docker-compose.override.yml

# Local service data, database exports and file uploads
postgres-data/
redis-data/
server/.data/
server/uploads/
uploads/
*.sql.gz
*.dump

# Secrets, private certificates and keystores
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Infrastructure tooling state
.terraform/
*.tfstate
*.tfstate.*
