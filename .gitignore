.yarn/install-state.gz

# Build output and tool caches (Vite / NestJS / TypeScript)
dist/
.vite/
server/.nestjs/
*.tsbuildinfo

# Test and coverage output
coverage/
backend/coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
