# Copia este archivo como server/.env. No subas server/.env al repositorio.
NODE_ENV=development
APP_PORT=3000
CORS_ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Conexión al servicio PostgreSQL instalado localmente.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=consulta_app
DB_PASSWORD=REEMPLAZA_CON_EL_SECRETO_LOCAL
DB_NAME=consulta_medica_dev

# Debe ser un valor aleatorio largo y exclusivo del entorno local.
JWT_SECRET=REEMPLAZA_CON_UN_SECRETO_ALEATORIO_LARGO
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
REFRESH_COOKIE_SECURE=false

# Redis es opcional en desarrollo. Al habilitarlo, usa la misma contraseña que REDIS_PASSWORD en .env.
REDIS_ENABLED=false
REDIS_REQUIRED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REEMPLAZA_CON_LA_CONTRASENA_DE_REDIS
REDIS_KEY_PREFIX=consulta_medica:
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
SESSION_IDLE_TTL_MINUTES=60
SESSION_IDLE_TTL_MINUTES=60

# Solo para la semilla local de desarrollo. No reutilices estas credenciales fuera de desarrollo.
DEV_SEED_ADMIN_EMAIL=admin.demo@consulta.local
DEV_SEED_ADMIN_PASSWORD=REEMPLAZA_CON_UNA_CONTRASENA_LOCAL_SEGURA
