# Valores para Docker Compose de desarrollo. Copia este archivo como .env y
# reemplaza todos los marcadores antes de iniciar contenedores.
POSTGRES_USER=consulta_app
POSTGRES_PASSWORD=REEMPLAZA_CON_UN_SECRETO_LOCAL
POSTGRES_DB=consulta_medica_dev
# PostgreSQL nativo usa el puerto 5432; Docker usa 5433 por defecto para evitar conflictos.
POSTGRES_PORT=5433
REDIS_PORT=6379
REDIS_PASSWORD=REEMPLAZA_CON_UN_SECRETO_LOCAL
